# =====================================================================
#  CarVision — muhit o'zgaruvchilari
#  Lokal: bu faylni `.env` deb nusxalang (`cp .env.example .env`).
#  Vercel: HECH QACHON .env faylini git'ga qo'shmang — qiymatlar Vercel >
#  Project > Settings > Environment Variables orqali kiritiladi (DEPLOY.md).
# =====================================================================

# ---------- Backend (apps/api) ----------
PORT=8787
NODE_ENV=development
# Frontend manzili (CORS). Production'da web loyihaning to'liq https manzili,
# oxirida "/"siz. Bir nechta bo'lsa vergul bilan: https://a.vercel.app,https://b.uz
WEB_APP_URL=http://localhost:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# DIQQAT: bu yerga SECRET kalit (sb_secret_... yoki service_role) qo'yiladi.
# Publishable/anon kalit XAVFSIZ EMAS: u bilan parol xeshlari va sessiyalar ochiq qoladi.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=carvision

# Migratsiyalar uchun (faqat lokal `npm run db:migrate`): Supabase > Database > Connection string > URI
DATABASE_URL=

# To'lov rejimi: mock (faqat dev/staging) | off (production)
PAYMENTS_MODE=mock

# AI image editing provider: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
# Gemini-mos gateway bo'lsa (masalan https://api2.laozhang.ai); bo'sh = Google'ning o'zi
GEMINI_BASE_URL=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- Frontend (apps/web) ----------
# Backend (API) loyihasining to'liq manzili, oxirida "/"siz.
# Lokal: http://localhost:8787 · Vercel: https://<api-loyiha>.vercel.app
VITE_API_URL=http://localhost:8787
