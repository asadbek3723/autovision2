# ---------- Backend (apps/api) ----------
PORT=8787
NODE_ENV=development
WEB_APP_URL=http://localhost:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=carvision

# Telegram — ixtiyoriy, faqat Mini App yoki Login Widget kerak bo'lsa (@BotFather)
TELEGRAM_BOT_TOKEN=
# Bot foydalanuvchi nomi (@ belgisisiz) — Login Widget shu bilan ishlaydi
TELEGRAM_BOT_USERNAME=
# Dev rejimda initData tekshiruvini o'chirish (faqat local, production'da taqiqlangan)
ALLOW_INSECURE_AUTH=true
# Brauzer login sessiya tokenlarini imzolash uchun — berilmasa bot tokendan olinadi
SESSION_SECRET=

# AI image editing provider: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- Frontend (apps/web) ----------
VITE_API_URL=http://localhost:8787
# Telegram Login Widget uchun bot foydalanuvchi nomi (TELEGRAM_BOT_USERNAME bilan bir xil)
VITE_TELEGRAM_BOT_USERNAME=
# Backenddagi ALLOW_INSECURE_AUTH bilan bir xil qiymatda tuting — true bo'lsa
# brauzerda Login sahifasi o'rniga to'g'ridan-to'g'ri soxta test foydalanuvchi bilan kiradi
VITE_ALLOW_INSECURE_AUTH=true
